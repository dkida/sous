{
  "name": "sous",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:agent": "node --env-file=.env.local --import tsx src/cli/agent.ts",
    "bench:models": "node --env-file=.env.local --import tsx src/benchmark/models.ts",
    "bench:schema": "node --env-file=.env.local --import tsx src/benchmark/schema-probe.ts",
    "bench:inference": "node --env-file=.env.local --import tsx src/benchmark/run.ts",
    "bench:quality": "node --env-file=.env.local --import tsx src/benchmark/quality.ts",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test --experimental-test-isolation=none src/domain/*.test.ts src/application/*.test.ts src/infrastructure/*.test.ts src/benchmark/*.test.ts src/web/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
