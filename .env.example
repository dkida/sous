# Server-only credentials. Supply privately; never commit populated copies.
# MISTRAL_API_KEY powers the default reasoning model, Mistral Small 4 (mistral-small-2603).
MISTRAL_API_KEY=
ELEVENLABS_API_KEY=
# Optional server settings. With no override the application selects mistral / mistral-small-2603.
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-small-2603
# ELEVENLABS_VOICE_ID=
# Only for the non-default alternates LLM_PROVIDER=gemma or gemini-flash-lite (and Gemini benchmarks).
# GEMINI_API_KEY=
# GEMMA_MODEL=
